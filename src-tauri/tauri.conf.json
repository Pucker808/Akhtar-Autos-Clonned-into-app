{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Akhtar Autos",
  "version": "0.1.0",
  "identifier": "com.akhtar.autos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Akhtar Autos",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "category": "Business",
    "shortDescription": "Akhtar Autos shop management",
    "longDescription": "Offline-first inventory, POS and accounts for Akhtar Autos spare-parts shop."
  }
}
