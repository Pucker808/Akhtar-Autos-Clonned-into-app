{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Akhtar Autos",
  "version": "0.1.0",
  "identifier": "com.akhtar.autos.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "Akhtar Autos",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2QjdGOUY3RDU3OTYxRDQKUldUVVlYblY5L20zbHVEaFFzUU5OUzE5UTVRU0JvSFVtT21vTHgrRUREcm1iSGhOZ3lVY013UHoK",
      "endpoints": [
        "https://github.com/Pucker808/Akhtar-Autos-Clonned-into-app/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "category": "Business",
    "shortDescription": "Akhtar Autos shop management",
    "longDescription": "Offline-first inventory, POS and accounts for Akhtar Autos spare-parts shop."
  }
}
